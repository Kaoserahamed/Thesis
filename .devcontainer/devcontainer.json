{
  "name": "River Morphology Thesis",
  "image": "mcr.microsoft.com/vscode/devcontainers/python:1-3.11-bookworm",
  "remoteUser": "vscode",
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": {
      "label": "JupyterLab",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "YEARLY_DIR": "${containerWorkspaceFolder}/data/raw/yearly",
    "QUARTERLY_DIR": "${containerWorkspaceFolder}/data/raw/quarterly",
    "BIMONTHLY_DIR": "${containerWorkspaceFolder}/data/raw/bimonthly",
    "TF_CPP_MIN_LOG_LEVEL": "3",
    "TF_ENABLE_ONEDNN_OPTS": "0"
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements.lock",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python black-formatter",
        "ms-python.flake8",
        "ms-python.mypy-type-checker",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "python.testing.unittestEnabled": false,
        "jupyter.notebookFileRoot": "${containerWorkspaceFolder}"
      }
    }
  }
}
