# Copy this file to .env for local, non-secret configuration.
# Do not put API keys, tokens, or service-account JSON in this file.

# Input directories containing year-tagged GeoTIFF water masks.
YEARLY_DIR=./data/raw/yearly
QUARTERLY_DIR=./data/raw/quarterly
BIMONTHLY_DIR=./data/raw/bimonthly

# TensorFlow runtime defaults for CPU notebooks and CI.
TF_CPP_MIN_LOG_LEVEL=3
TF_ENABLE_ONEDNN_OPTS=0
XLA_FLAGS=--xla_gpu_strict_conv_algorithm_picker=false

# Structured logging controls.
THESIS_LOG_LEVEL=INFO
THESIS_LOG_JSON=false
# THESIS_LOG_FILE=./logs/thesis.jsonl

# Error tracker local retention and optional JSONL sink.
THESIS_ERROR_MAX_BUFFER=1000
# THESIS_ERROR_SINK=./logs/errors.jsonl

# Optional: set this when a notebook or Earth Engine workflow asks for a
# specific Google Cloud project. Authenticate separately with:
#   earthengine authenticate
# EE_PROJECT=

# Optional external error-monitoring webhook; delivery failures do not stop runs.
THESIS_ERROR_WEBHOOK_URL=

# MLflow experiment name used to group comparable contributor runs.
MLFLOW_EXPERIMENT_NAME=
# Local file-backed MLflow store; replace with a shared tracking server if needed.
MLFLOW_TRACKING_URI=file:./mlruns

# Minimum free disk space required by health checks, in gigabytes.
THESIS_DISK_FREE_GB=5
